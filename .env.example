EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me.apps.googleusercontent.com
EXPO_PUBLIC_APP_SCHEME=sportz
EXPO_PUBLIC_CANONICAL_WEB_URL=https://sportz.app
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/sportz
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.sportz.mobile
# Used by `npm run links:associations` to generate deployable verification files.
IOS_TEAM_ID=replace_with_apple_team_id
ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:replace_with_production_signing_fingerprint
EXPO_PUBLIC_MAP_PROVIDER=apple
EXPO_PUBLIC_APP_ENV=development
# A Sentry DSN is public configuration. Leave blank to disable reporting.
EXPO_PUBLIC_SENTRY_DSN=
# Development events are isolated and disabled unless explicitly opted in.
EXPO_PUBLIC_ENABLE_DEV_MONITORING=false
