{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "strict": true
  },
  "include": [
    "src",
    "index.js"
  ],
  "exclude": [
    "src/__tests__",
    "src/test"
  ]
}
