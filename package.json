{
  "name": "sportz-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "npm run android:generate && npm run android:check -- --variant debug && expo run:android",
    "android:generate": "expo prebuild --clean --platform android --no-install",
    "android:check": "node scripts/check-android-cng.mjs",
    "android:debug:check": "npm run android:generate && npm run android:check -- --variant debug",
    "android:release:check": "npm run android:generate && npm run android:check -- --variant release",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "links:associations": "node scripts/generate-association-files.mjs",
    "links:validate": "node scripts/validate-association-files.mjs",
    "links:validate:remote": "node scripts/validate-association-files.mjs --remote",
    "config:destinations": "node scripts/validate-product-destinations.mjs",
    "links:fallback": "node scripts/generate-link-fallback.mjs",
    "links:release-assets": "npm run config:destinations && npm run links:associations && npm run links:fallback && npm run links:validate",
    "config:runtime": "node scripts/validate-expo-runtime.mjs",
    "supabase:types": "supabase gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "0.4.1",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "2.108.0",
    "@tanstack/query-async-storage-persister": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "date-fns": "4.4.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-modules-core": "~57.0.18",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-video": "~57.0.4",
    "expo-video-thumbnails": "~57.0.2",
    "i18next": "^26.3.6",
    "lucide-react-native": "1.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "supabase": "^2.98.2",
    "tus-js-client": "^4.3.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "latest",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  }
}
